# Copy to backend/.env. No live secrets belong in git.
# Optional for the current thin backend. /health and stub /optimize work without them.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# JWT secret from Project Settings → API (legacy HS256). If unset, backend skips JWT checks.
SUPABASE_JWT_SECRET=
